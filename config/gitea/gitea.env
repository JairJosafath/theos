# Gitea configuration, applied to app.ini on every start by the image's
# environment-to-ini. Format: GITEA__<section>__<KEY>=value.
# Reference: https://docs.gitea.com/administration/config-cheat-sheet

# Server: plain HTTP on 3000 under the in-cluster name, no SSH.
GITEA__server__DOMAIN=gitea.gitea.svc.cluster.local
GITEA__server__HTTP_PORT=3000
GITEA__server__ROOT_URL=http://gitea.gitea.svc.cluster.local:3000/
GITEA__server__DISABLE_SSH=true
GITEA__server__START_SSH_SERVER=false
GITEA__server__OFFLINE_MODE=true

# SQLite on the volume; no separate database.
GITEA__database__DB_TYPE=sqlite3
GITEA__database__PATH=/var/lib/gitea/data/gitea.db

# Skip the web installer; accounts come from the admin Secret and the seed Job.
GITEA__security__INSTALL_LOCK=true
GITEA__service__DISABLE_REGISTRATION=true
GITEA__service__REQUIRE_SIGNIN_VIEW=false

GITEA__repository__DEFAULT_BRANCH=main

# Keep it light: database-backed issue search, quieter logs.
GITEA__indexer__ISSUE_INDEXER_TYPE=db
GITEA__log__LEVEL=Warn

# Actions: CI for Container repositories, on the runner in config/runner.
GITEA__actions__ENABLED=true
