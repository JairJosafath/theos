    {
      "id": "wcT2-Gl8xDnlvr72fCLyk",
      "type": "text",
      "x": 5,
      "y": 105,
      "width": 1942,
      "height": 59.400000000000006,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1k",
      "roundness": null,
      "seed": 388671274,
      "version": 3,
      "versionNonce": 413175146,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791061570781,
      "link": null,
      "locked": false,
      "text": "You tell the story as a C4 model in Kubernetes. The operator scaffolds one Git repository per Container, Crews turn ready issues into Tasks, agents implement and review them in sandboxes, and\nonly what passes CI and review is merged.",
      "fontSize": 22,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r2",
      "originalText": "You tell the story as a C4 model in Kubernetes. The operator scaffolds one Git repository per Container, Crews turn ready issues into Tasks, agents implement and review them in sandboxes, and only what passes CI and review is merged.",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "G_iTK6zetl-CofGvmt7Mu",
      "type": "text",
      "x": 41,
      "y": 459,
      "width": 417,
      "height": 22.950000000000003,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1l",
      "roundness": null,
      "seed": 308294122,
      "version": 3,
      "versionNonce": 696833590,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791061570781,
      "link": null,
      "locked": false,
      "text": "kubectl, GitOps or the UI: anything can write the model.",
      "fontSize": 17,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r23",
      "originalText": "kubectl, GitOps or the UI: anything can write the model.",
      "autoResize": true,
      "lineHeight": 1.35
    },
