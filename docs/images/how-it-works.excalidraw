    {
      "id": "V3taoXP1oXRRShg-4q1vw",
      "type": "text",
      "x": 41,
      "y": 755,
      "width": 440,
      "height": 160.65000000000003,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1p",
      "roundness": null,
      "seed": 1914056374,
      "version": 3,
      "versionNonce": 992297142,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791061570781,
      "link": null,
      "locked": false,
      "text": "Story: Project, Person, SoftwareSystem (needs, KPIs),\nContainer, DataStore, Relationship.\nCatalog: GitProvider, Framework, Standard, Compute,\nDeployment, Connector, Agent.\nWork: Crew, Task, Session.\nCEL rules and an admission policy guard the model; the UI\nenforces nothing.",
      "fontSize": 17,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r38",
      "originalText": "Story: Project, Person, SoftwareSystem (needs, KPIs), Container, DataStore, Relationship.\nCatalog: GitProvider, Framework, Standard, Compute, Deployment, Connector, Agent.\nWork: Crew, Task, Session.\nCEL rules and an admission policy guard the model; the UI enforces nothing.",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "AoTQZO6UUEQcJ_F4ByssU",
      "type": "text",
      "x": 621,
      "y": 459,
      "width": 506,
      "height": 72.9,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1q",
      "roundness": null,
      "seed": 671803382,
      "version": 3,
      "versionNonce": 1700056490,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791061570781,
      "link": null,
      "locked": false,
      "text": "Resolves the references, checks every catalog entry supports\nthe Container's type, creates the repository and renders the\nlayers into one commit.",
      "fontSize": 18,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r45",
      "originalText": "Resolves the references, checks every catalog entry supports the Container's type, creates the repository and renders the layers into one commit.",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "VmGgAOh_6PoJPLv2z3oWh",
      "type": "text",
      "x": 621,
      "y": 639,
      "width": 178,
      "height": 72.9,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1r",
      "roundness": null,
      "seed": 470900010,
      "version": 3,
      "versionNonce": 1634187766,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791061570781,
      "link": null,
      "locked": false,
      "text": "Template repos at a\npinned tag or commit,\nnever a branch.",
      "fontSize": 18,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r51",
      "originalText": "Template repos at a pinned tag or commit, never a branch.",
      "autoResize": true,
      "lineHeight": 1.35
    },
