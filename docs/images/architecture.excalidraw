      "versionNonce": 222709157,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791062185768,
      "link": null,
      "locked": false,
      "text": "Project, SoftwareSystem, Container,\nDataStore, Relationship, the catalog,\nAgents, Crews, Tasks and Sessions.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r97",
      "originalText": "Project, SoftwareSystem, Container, DataStore, Relationship, the catalog, Agents, Crews, Tasks and Sessions.",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "5ZIE3zY2ihRX-MR2Wur3N",
      "type": "text",
      "x": 873,
      "y": 1203,
      "width": 283,
      "height": 45.900000000000006,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
