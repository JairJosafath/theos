      "isDeleted": false,
      "boundElements": [],
      "updated": 1791062185768,
      "link": null,
      "locked": false,
      "text": "gitea-credentials, claude-credentials,\n<container>-agent-git",
      "fontSize": 17,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r101",
