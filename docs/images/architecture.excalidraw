      "groupIds": [],
      "frameId": null,
      "index": "b2l",
      "roundness": null,
      "seed": 1237044965,
      "version": 3,
      "versionNonce": 2048411909,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791062185768,
      "link": null,
      "locked": false,
      "text": "A ServiceAccount that may only write\nSessions.",
      "fontSize": 17,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r105",
      "originalText": "A ServiceAccount that may only write Sessions.",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "SBky5ulAbGNorSvqXDIsJ",
      "type": "text",
      "x": 1253,
      "y": 1203,
      "width": 595.9411764705883,
      "height": 108.0,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2m",
      "roundness": null,
      "seed": 965388869,
      "version": 4,
      "versionNonce": 154170827,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791062185768,
      "link": null,
      "locked": false,
      "text": "One Sandbox per agent run, owned by its Task. The pod runs c4agent\nand Claude Code on a toolchain image (agent-base, agent-go), with\nits workspace in memory and no ServiceAccount token. Its result\nleaves as JSON in the termination message.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r110",
      "originalText": "One Sandbox per agent run, owned by its Task. The pod runs c4agent and Claude Code on a toolchain image (agent-base, agent-go), with its workspace in memory and no ServiceAccount token. Its result leaves as JSON in the termination message.",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "z5Ab3kAEjc4Rpfd1uRn7I",
      "type": "text",
      "x": 1977,
      "y": 1203,
      "width": 331,
      "height": 81,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2n",
      "roundness": null,
      "seed": 900143525,
      "version": 3,
      "versionNonce": 949149797,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791062185768,
      "link": null,
      "locked": false,
      "text": "NetworkPolicy: no ingress. Egress to\nDNS, Gitea, and HTTPS on public\naddresses only.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r114",
      "originalText": "NetworkPolicy: no ingress. Egress to DNS, Gitea, and HTTPS on public addresses only.",
      "autoResize": true,
      "lineHeight": 1.35
    },
