    },
    {
      "id": "ZtICd2EEafj-Wk2kKQv1G",
      "type": "text",
      "x": 873,
      "y": 1349,
      "width": 286,
      "height": 45.900000000000006,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
