// C4 Factory dev container.
// Go and kubebuilder for the operator, Docker-in-Docker and Kind for the in-cluster
// test environment, uv and Node for the templates and the UI, and a zsh that
// suggests as you type. Format: https://containers.dev/implementors/json_reference/
{
	"name": "C4 Factory",
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",

	"features": {
		// Kind runs its cluster inside this Docker. Its images live in a volume the
		// feature creates, so the kind node image survives a rebuild.
		"ghcr.io/devcontainers/features/docker-in-docker:4": {},
		"ghcr.io/devcontainers/features/go:1": { "version": "1.26" },
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" },
		"ghcr.io/devcontainers-extra/features/kind:1": {},
		// The read-only UI (milestone 6) and the Dev Container CLI.
		"ghcr.io/devcontainers/features/node:1": { "version": "lts" },
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},
	"overrideFeatureInstallOrder": [
		"ghcr.io/devcontainers/features/node",
		"ghcr.io/anthropics/devcontainer-features/claude-code"
	],

	"mounts": [
		// Shell history survives rebuilds, so the suggestions keep learning.
		"source=c4factory-shell-history,target=/commandhistory,type=volume",
		// Claude Code login and settings survive rebuilds.
		"source=c4factory-claude-config,target=/home/vscode/.claude,type=volume"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
	},

	// Installs kubebuilder, uv, fzf and the Dev Container CLI, and sets up zsh.
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	// Go's build cache grows without bound across worktrees; keep it under 4 GB.
	"postStartCommand": "bash hack/trim-go-cache.sh",

	// Gitea, once you run: kubectl port-forward -n gitea svc/gitea 3000:3000
	"forwardPorts": [3000, 8080],
	"portsAttributes": {
		"3000": { "label": "Gitea", "onAutoForward": "silent" },
		"8080": { "label": "C4 Factory UI", "onAutoForward": "silent" }
	},

	// Kind, Gitea and Go builds together want some room.
	"hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },

	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"ms-kubernetes-tools.vscode-kubernetes-tools",
				"redhat.vscode-yaml",
				"anthropic.claude-code"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh",
				"go.toolsManagement.autoUpdate": true,
				"[go]": { "editor.formatOnSave": true },
				// Keep main current: fetch in the background, and let the "Pull main"
				// task in .vscode/tasks.json start when the folder opens.
				"git.autofetch": true,
				"task.allowAutomaticTasks": "on"
			}
		}
	},

	"remoteUser": "vscode"
}
