// C4 Factory light dev container, for a device with too little disk for Kind.
// Go, Node, git, the GitHub CLI and Claude Code; no Docker-in-Docker, Kind,
// kubectl or Helm. C4_CLUSTER=none tells hack/lib/github.sh and hack/relay.sh
// that there is no cluster here, so its relay takes only issues without
// needs/cluster. What it can and can't do: README.md, "A device without the
// cluster". Format: https://containers.dev/implementors/json_reference/
{
	"name": "C4 Factory (lite, no cluster)",
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",

	"features": {
		"ghcr.io/devcontainers/features/go:1": { "version": "1.26" },
		"ghcr.io/devcontainers/features/node:1": { "version": "lts" },
		"ghcr.io/devcontainers/features/git:1": {},
		// hack/lib/github.sh calls GitHub through gh.
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},
	"overrideFeatureInstallOrder": [
		"ghcr.io/devcontainers/features/node",
		"ghcr.io/anthropics/devcontainer-features/claude-code"
	],

	"mounts": [
		"source=c4factory-shell-history,target=/commandhistory,type=volume",
		"source=c4factory-claude-config,target=/home/vscode/.claude,type=volume"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
		"C4_CLUSTER": "none"
	},

	// The same setup as the full container, minus what needs a cluster.
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	// Go's build cache grows without bound across worktrees; keep it under 4 GB.
	"postStartCommand": "bash hack/trim-go-cache.sh",

	// Go builds, envtest and golangci-lint, without Kind and Gitea.
	"hostRequirements": { "cpus": 2, "memory": "4gb", "storage": "16gb" },

	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"redhat.vscode-yaml",
				"anthropic.claude-code"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh",
				"go.toolsManagement.autoUpdate": true,
				"[go]": { "editor.formatOnSave": true }
			}
		}
	},

	"remoteUser": "vscode"
}
