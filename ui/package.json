{
  "name": "c4factory-ui",
  "private": true,
  "version": "0.1.0",
  "description": "UI for C4 Factory: draws the story from the custom resources, live through watches; its only writes create a Brief, add a prompt to one, and pause or resume one.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && node server.mjs",
    "start": "node server.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test test/server.test.mjs test/health.test.mjs test/ansi.test.mjs test/browser.test.mjs",
    "test:unit": "vitest run",
    "test:node": "node --test test/server.test.mjs test/health.test.mjs test/ansi.test.mjs test/browser.test.mjs",
    "test:e2e": "npm run build && node --test test/live.e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "screenshot": "node scripts/screenshot.mjs",
    "screenshot:views": "npm run build && node scripts/views.mjs",
    "term-shot": "node scripts/term-shot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
