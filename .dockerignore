# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
# If you use Podman, re-include your source directories by name,
# such as !cmd, !api, and !internal.
# See https://github.com/containers/buildah/issues/6417
!**/*.go
**/*_test.go

# The files the operator embeds with //go:embed; cmd/dockerignore_test.go
# fails when one is missing here.
!features/src/**
!internal/model/planner.md
!internal/adapters/cloudformation/bootstrap-template-v*.yaml
!internal/scaffold/licenses/*.txt

# Re-include Go module files
!go.mod
!go.sum

# Local agent worktrees (Claude Code) are not part of any image.
.claude/
