{
  "compilerOptions": {
    // esbuild bundles the server and tsx runs the CDK app; tsc only
    // type-checks.
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    // The CDK app names its stack from package.json.
    "resolveJsonModule": true,
    // engines.node >=22, which has all of ES2023.
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Off: aws-cdk-lib's own classes break it. A Vpc is not an IVpc under it
    // (vpnGatewayId), nor a Bucket an IBucket (isWebsite), so no stack with a
    // network or a bucket type-checks.
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src", "infra", "vitest.config.mts"]
}
