{
  "name": "{{ .Container }}",
  "displayName": {{ printf "%q" (or .DisplayName .Container) }},
  "description": "The {{ .Container }} extension of {{ .SoftwareSystem }}.",
  "version": "0.0.1",
  "publisher": "{{ .Project }}",
  "private": true,
  "license": "{{ or .License.ID "UNLICENSED" }}",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "{{ .Container }}.sayHello",
        "title": "Say Hello",
        "category": {{ printf "%q" (or .DisplayName .Container) }}
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@vscode/vsce-sign": false
  }
}
