# Kubernetes manifests for {{ .Container }}; render them with `kubectl kustomize deploy/k8s`.
# Shipping is left to your tools (Argo CD, Flux, a pipeline). Point the image at
# what you build from the Dockerfile, for example:
#   cd deploy/k8s && kustomize edit set image {{ .Container }}=registry.example.com/{{ .Container }}:1.0.0
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - deployment.yaml
{{- if eq .Type "service" }}
  - service.yaml
{{- end }}
{{- range .Connectors }}
  - connector-{{ . }}.yaml
{{- end }}
patches:
  # Resources from the Compute layer.
  - path: compute.yaml
