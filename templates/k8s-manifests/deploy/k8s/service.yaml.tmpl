{{- if or (eq .Type "service") (eq .Type "static-site") -}}
apiVersion: v1
kind: Service
metadata:
  name: {{ .Container }}
  labels:
    app.kubernetes.io/name: {{ .Container }}
    app.kubernetes.io/part-of: {{ .SoftwareSystem }}
spec:
  selector:
    app.kubernetes.io/name: {{ .Container }}
  ports:
    - name: http
      port: 80
      targetPort: http
{{- end }}
