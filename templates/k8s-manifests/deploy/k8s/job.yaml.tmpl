{{- /* A job runs the image to completion, once per release: no port, no
probes, restartPolicy Never. Argo CD replaces the Job on each sync instead of
patching it (a Job's template is immutable), so a release with a new image
runs it again; the annotation is inert outside Argo CD. No
ttlSecondsAfterFinished: the argoCD target syncs with selfHeal, which would
recreate a Job the TTL deleted and run it again every TTL (#1587); the
finished Job and its pod stay, with their logs, until the next release
replaces them. Like the Deployment, it loads a ConfigMap per Connector
through envFrom and, with postgres, PGPASSWORD from the Secret. */ -}}
{{- if eq .Type "job" -}}
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ .Container }}
  labels:
    app.kubernetes.io/name: {{ .Container }}
    app.kubernetes.io/part-of: {{ .SoftwareSystem }}
  annotations:
    # A Job's template is immutable: Argo CD replaces the Job instead of
    # patching it, so each release runs it again. Inert outside Argo CD.
    argocd.argoproj.io/sync-options: Replace=true
spec:
  backoffLimit: 3
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ .Container }}
        app.kubernetes.io/part-of: {{ .SoftwareSystem }}
    spec:
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: app
          # Built from the Dockerfile; override it in kustomization.yaml.
          image: {{ .Container }}:dev
{{- if .Connectors }}
          envFrom:
            # Connection settings, one ConfigMap per Connector.
{{- range .Connectors }}
            - configMapRef:
                name: {{ $.Container }}-{{ . }}
{{- end }}
{{- end }}
{{- if has .Connectors "postgres" }}
          env:
            # The database password, from the Secret the postgres Connector reads.
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ .Container }}-postgres
                  key: password
{{- end }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
{{- end }}
