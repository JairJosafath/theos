{{- /* The port and health check of the image the Dockerfile builds: uvicorn
on 8000 with GET /healthz, or for react-vite nginx on 8080, where serving the
page is the check. A python-cli worker serves nothing: no port and no probes,
and Kubernetes restarts it when it exits. python-fastapi with postgres has
GET /readyz, which runs SELECT 1: the readiness probe asks it, so a pod whose
database is down leaves the Service, and liveness stays on /healthz, so the
outage never restarts it (#1528). python-fastapi loads OIDC_ISSUER and
OIDC_AUDIENCE from ConfigMap <container>-auth, auth.yaml (#1540). */ -}}
{{- $port := 8000 }}{{ $probe := "/healthz" }}{{ $http := true -}}
{{- if eq .Framework "react-vite" }}{{ $port = 8080 }}{{ $probe = "/" }}{{ end -}}
{{- if eq .Framework "python-cli" }}{{ $http = false }}{{ end -}}
{{- $ready := $probe -}}
{{- $auth := eq .Framework "python-fastapi" -}}
{{- if and (eq .Framework "python-fastapi") (has .Connectors "postgres") }}{{ $ready = "/readyz" }}{{ end -}}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Container }}
  labels:
    app.kubernetes.io/name: {{ .Container }}
    app.kubernetes.io/part-of: {{ .SoftwareSystem }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .Container }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ .Container }}
        app.kubernetes.io/part-of: {{ .SoftwareSystem }}
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: app
          # Built from the Dockerfile; override it in kustomization.yaml.
          image: {{ .Container }}:dev
{{- if $http }}
          ports:
            - name: http
              containerPort: {{ $port }}
{{- end }}
{{- if or .Connectors $auth }}
          envFrom:
{{- if $auth }}
            # The token issuer and audience the app verifies against.
            - configMapRef:
                name: {{ .Container }}-auth
{{- end }}
{{- if .Connectors }}
            # Connection settings, one ConfigMap per Connector.
{{- end }}
{{- range .Connectors }}
            - configMapRef:
                name: {{ $.Container }}-{{ . }}
{{- end }}
{{- end }}
{{- if has .Connectors "postgres" }}
          env:
            # The database password, from the Secret the postgres Connector reads.
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ .Container }}-postgres
                  key: password
{{- end }}
{{- if $http }}
          readinessProbe:
            httpGet:
              path: {{ $ready }}
              port: http
          livenessProbe:
            httpGet:
              path: {{ $probe }}
              port: http
            initialDelaySeconds: 10
{{- end }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
