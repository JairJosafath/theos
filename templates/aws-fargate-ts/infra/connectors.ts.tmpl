// The data stores the Container's Relationships connect it to: one entry per
// Connector of a DataStore it uses, each made by the Connector's own
// infra/connector_<name>.ts. The factory renders this list from the
// Connectors at scaffold; the stack connects each to the service and alarms
// on it, and in production backs it up by ARN with its own.
import type { Table } from 'aws-cdk-lib/aws-dynamodb';
import type { Connections, IVpc } from 'aws-cdk-lib/aws-ec2';
import type { IGrantable } from 'aws-cdk-lib/aws-iam';
import type { DatabaseCluster } from 'aws-cdk-lib/aws-rds';
import type { Construct } from 'constructs';
{{- if or (has .Connectors "dynamodb") (has .Connectors "rds") }}
{{ end }}
{{- if has .Connectors "dynamodb" }}
import { connectDynamoDB } from './connector_dynamodb';
{{- end }}
{{- if has .Connectors "rds" }}
import { connectRDS } from './connector_rds';
{{- end }}
import type { TierRules } from './standard';

/**
 * What uses a data store: something the store can grant to, which takes the
 * store's names from its environment, and the network it runs in. The stack
 * passes the service's role, the environment the service runs with, and its
 * VPC and its tasks' security group, so a cluster goes in the VPC and lets
 * the tasks in.
 */
export type DataStoreUser = IGrantable & {
  addEnvironment(key: string, value: string): unknown;
  readonly network?: { readonly vpc: IVpc; readonly connections: Connections };
};

/** What a Connector makes: a DynamoDB table (`dynamodb`) or an Aurora cluster (`rds`). */
export type DataStore = Table | DatabaseCluster;

/** Makes a data store in `scope` for the tier's `rules`, and lets `user` use it. */
export type Connect = (scope: Construct, user: DataStoreUser, rules: TierRules) => DataStore;

/** Each data store: its name, which its alarms carry, and how it connects. */
export const DATA_STORES: readonly (readonly [string, Connect])[] = [
{{- if and (has .Connectors "dynamodb") (has .Connectors "rds") }}
  ['DynamoDB', connectDynamoDB],
  ['RDS', connectRDS],
{{ else if has .Connectors "dynamodb" -}}
['DynamoDB', connectDynamoDB]
{{- else if has .Connectors "rds" -}}
['RDS', connectRDS]
{{- end -}}
];
