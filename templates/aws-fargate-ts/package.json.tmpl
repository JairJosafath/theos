{
  "name": "{{ .Container }}",
  "description": "The {{ .Container }} service of {{ .SoftwareSystem }}.",
  "version": "0.0.1",
  "private": true,
  "license": "{{ or .License.ID "UNLICENSED" }}",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "bundle": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --minify --sourcemap --outfile=dist/main.cjs",
    "synth": "cdk synth --quiet"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1150.0",
    "@aws-sdk/lib-dynamodb": "3.1150.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "aws-jwt-verify": "5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.273.0",
    "cdk-monitoring-constructs": "10.3.2",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
