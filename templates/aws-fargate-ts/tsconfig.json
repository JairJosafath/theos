{
  "compilerOptions": {
    // esbuild bundles the service and tsx runs the CDK app; tsc only
    // type-checks.
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    // The CDK app names its stack from package.json.
    "resolveJsonModule": true,
    // engines.node >=22, which has all of ES2023.
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Not exactOptionalPropertyTypes: under it aws-cdk-lib's classes don't
    // satisfy their own interfaces (a Vpc is no IVpc), so no stack compiles.
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src", "infra", "vitest.config.mts"]
}
