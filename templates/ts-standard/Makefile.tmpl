# The quality contract of this repository. CI runs `make check` on every pull
# request, or, when the Container's checks are BeforeRelease, `make check-light`
# there and `make check` before each release; agents and people run
# `make check` before every commit. `make help` lists the targets.

NAME := {{ .Container }}
BIN := node_modules/.bin
{{- if eq .Framework "react-vite" }}

.DEFAULT_GOAL := help
.PHONY: help check check-light deps fmt fmt-check lint typecheck test build-check dist clean
{{- else if eq .Framework "node-cli" }}
# The program's version is the one in package.json. A release passes its tag,
# which must match: make dist VERSION=v1.2.3
PACKAGE_VERSION := $(shell node -p "require('./package.json').version")
VERSION ?= v$(PACKAGE_VERSION)

.DEFAULT_GOAL := help
.PHONY: help check check-light deps fmt fmt-check lint typecheck test build pack-check dist release-version clean
{{- else }}
# The extension's version is the one in package.json. A release passes its tag,
# which must match: make dist VERSION=v1.2.3
PACKAGE_VERSION := $(shell node -p "require('./package.json').version")
VERSION ?= v$(PACKAGE_VERSION)
# vsce builds the bundle with package.json's vscode:prepublish script. No
# dependencies to add (esbuild bundled them), no licence or repository prompts.
VSCE := $(BIN)/vsce package --no-dependencies --skip-license --allow-missing-repository

.DEFAULT_GOAL := help
.PHONY: help check check-light deps fmt fmt-check lint typecheck test build package-check dist release-version clean
{{- end }}

help: ## List the targets.
	@awk 'BEGIN {FS = ":.*## "} /^[a-z-]+:.*## / {printf "  %-14s %s\n", $$1, $$2}' $(MAKEFILE_LIST)
{{ if eq .Framework "react-vite" }}
check: deps fmt-check lint typecheck test build-check ## Everything CI checks.
{{- else if eq .Framework "node-cli" }}
check: deps fmt-check lint typecheck test pack-check ## Everything CI checks.
{{- else }}
check: deps fmt-check lint typecheck test package-check ## Everything CI checks.
{{- end }}

check-light: deps fmt-check lint typecheck ## check without the tests, which CI runs on each change with checks BeforeRelease.

deps: ## Install the exact packages in package-lock.json.
	npm ci --no-audit --no-fund

fmt: ## Format every file with Prettier.
	$(BIN)/prettier --write .

fmt-check: ## Fail when a file is not formatted.
	$(BIN)/prettier --check .

lint: ## Lint with eslint.config.mjs, failing on any finding.
	$(BIN)/eslint --max-warnings 0 .

typecheck: ## Type-check with tsconfig.json.
	$(BIN)/tsc --noEmit

test: ## Run the unit tests.
	$(BIN)/vitest run
{{ if eq .Framework "react-vite" }}
build-check: ## Fail when the site does not build.
	@tmp=$$(mktemp -d) && trap 'rm -rf "$$tmp"' EXIT && \
		$(BIN)/vite build --outDir "$$tmp" --emptyOutDir

dist: deps ## Build the site into dist/ for a release.
	rm -rf dist
	$(BIN)/vite build

clean: ## Remove build output.
	rm -rf dist
{{- else if eq .Framework "node-cli" }}
build: ## Bundle the program into out/cli.js.
	node esbuild.mjs

pack-check: ## Fail when the package does not pack or its program does not run.
	@tmp=$$(mktemp -d) && trap 'rm -rf "$$tmp"' EXIT && \
		npm pack --silent --pack-destination "$$tmp" > /dev/null && \
		tar -xzf "$$tmp"/*.tgz -C "$$tmp" && \
		node "$$tmp/package/out/cli.js" --version

dist: release-version deps ## Pack dist/{{ .Container }}-<version>.tgz for a release.
	rm -rf dist
	mkdir -p dist
	npm pack --pack-destination dist

release-version: # Fail when VERSION is not package.json's version.
	@if [ "$(VERSION)" != "v$(PACKAGE_VERSION)" ]; then \
		echo "Tag $(VERSION) does not match version $(PACKAGE_VERSION) in package.json." >&2; \
		echo "Set \"version\": \"$(VERSION:v%=%)\" there, add its CHANGELOG.md entry, then tag again." >&2; \
		exit 1; \
	fi

clean: ## Remove build output.
	rm -rf out dist
{{- else }}
build: ## Bundle the extension into out/, minified.
	node esbuild.mjs --production

package-check: ## Fail when the extension does not package.
	@tmp=$$(mktemp -d) && trap 'rm -rf "$$tmp"' EXIT && \
		$(VSCE) --out "$$tmp/$(NAME).vsix"

dist: release-version deps ## Package dist/{{ .Container }}-<version>.vsix for a release.
	rm -rf dist
	mkdir -p dist
	$(VSCE) --out dist/$(NAME)-$(PACKAGE_VERSION).vsix

release-version: # Fail when VERSION is not package.json's version.
	@if [ "$(VERSION)" != "v$(PACKAGE_VERSION)" ]; then \
		echo "Tag $(VERSION) does not match version $(PACKAGE_VERSION) in package.json." >&2; \
		echo "Set \"version\": \"$(VERSION:v%=%)\" there, add its CHANGELOG.md entry, then tag again." >&2; \
		exit 1; \
	fi

clean: ## Remove build output.
	rm -rf out dist
{{- end }}
