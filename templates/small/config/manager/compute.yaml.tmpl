{{- if eq .Type "operator" -}}
# Compute "small": resources for the operator's container `manager`. A
# strategic-merge patch, applied through `patches` in kustomization.yaml.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: controller-manager
  namespace: system
spec:
  template:
    spec:
      containers:
        - name: manager
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 250m
              memory: 256Mi
{{ end -}}
