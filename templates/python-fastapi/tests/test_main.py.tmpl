class FakeConnection:
    """Records the queries it runs, or fails them with error."""

    def __init__(self, error: psycopg.Error | None) -> None:
        self.error = error
        self.queries: list[str] = []

    def execute(self, query: str) -> None:
        if self.error is not None:
            raise self.error
        self.queries.append(query)


class FakePool:
    """Lends its one FakeConnection, the way ConnectionPool.connection does."""

    def __init__(self, error: psycopg.Error | None = None) -> None:
        self.conn = FakeConnection(error)

    @contextmanager
    def connection(self, timeout: float | None = None) -> Iterator[FakeConnection]:
        assert timeout is not None, "/readyz must not wait forever for a connection"
        yield self.conn


def test_readyz_when_the_database_answers() -> None:
    pool = FakePool()
    app.dependency_overrides[db.get_pool] = lambda: pool
    response = client.get("/readyz")
    assert response.status_code == 200
    assert response.json() == {"database": "ok"}
    assert pool.conn.queries == ["SELECT 1"]


def test_readyz_when_the_database_fails() -> None:
    pool = FakePool(psycopg.OperationalError("connection refused"))
    app.dependency_overrides[db.get_pool] = lambda: pool
    response = client.get("/readyz")
    assert response.status_code == 503
    assert response.json() == {"database": "unreachable"}


def test_readyz_against_the_database(monkeypatch: pytest.MonkeyPatch) -> None:
    """The devcontainer's Postgres, which DATABASE_URL names there."""
    monkeypatch.setenv("AUTH_DISABLED", "true")
    url = os.environ.get("DATABASE_URL")
    if not url:
        pytest.skip("DATABASE_URL is not set; the devcontainer sets it to its Postgres")
    try:
        psycopg.connect(url, connect_timeout=2).close()
    except psycopg.OperationalError as err:
        pytest.skip(f"DATABASE_URL reaches no server: {err}")
    with TestClient(app) as live:
        response = live.get("/readyz")
    assert response.status_code == 200
    assert response.json() == {"database": "ok"}
