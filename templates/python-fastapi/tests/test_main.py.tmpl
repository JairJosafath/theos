@pytest.fixture
def log_lines() -> Iterator[io.StringIO]:
    """Catch the log lines in a buffer, then send them to stdout again."""
    stream = io.StringIO()
    logs.configure(stream)
    yield stream
    logs.configure()


def request_lines(stream: io.StringIO) -> list[dict[str, object]]:
    """The JSON lines logged for requests."""
    lines = [json.loads(line) for line in stream.getvalue().splitlines()]
    return [line for line in lines if line["logger"] == "app.request"]


def test_one_json_line_per_request(log_lines: io.StringIO) -> None:
    response = client.get(
        "/healthz?token=query-secret",
        headers={"X-Request-Id": "req-1", "Authorization": "Bearer header-secret"},
    )
    assert response.headers["X-Request-Id"] == "req-1"
    [line] = request_lines(log_lines)
    assert isinstance(line["durationMs"], float)
    del line["time"], line["durationMs"]
    assert line == {
        "level": "INFO",
        "logger": "app.request",
        "message": "GET /healthz 200",
        "method": "GET",
        "path": "/healthz",
        "status": 200,
        "requestId": "req-1",
    }


def test_a_request_without_an_id_gets_a_new_one(log_lines: io.StringIO) -> None:
    response = client.get("/missing", headers={"X-Request-Id": "not an id"})
    assert response.status_code == 404
    request_id = response.headers["X-Request-Id"]
    assert len(request_id) == 32
    [line] = request_lines(log_lines)
    assert line["requestId"] == request_id
    assert line["status"] == 404


def test_log_level_comes_from_the_environment(
    monkeypatch: pytest.MonkeyPatch, log_lines: io.StringIO
) -> None:
    monkeypatch.setenv("LOG_LEVEL", "warning")
    logs.configure(log_lines)
    client.get("/healthz")
    monkeypatch.delenv("LOG_LEVEL")
    assert log_lines.getvalue() == ""


@pytest.mark.usefixtures("log_lines")
def test_uvicorns_access_log_is_off() -> None:
    access = logging.getLogger("uvicorn.access")
    assert access.disabled
    assert not access.propagate
