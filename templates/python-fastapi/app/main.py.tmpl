"""{{ .DisplayName }}: the {{ .Container }} {{ .Type }} of {{ .SoftwareSystem }}."""
{{ if has .Connectors "postgres" }}
from collections.abc import AsyncIterator
from contextlib import asynccontextmanager
from typing import Annotated

from fastapi import Depends, FastAPI, Response
from psycopg_pool import ConnectionPool

from app import db, logs
{{- else }}
from fastapi import FastAPI

from app import logs
{{- end }}

CONTAINER = "{{ .Container }}"
SOFTWARE_SYSTEM = "{{ .SoftwareSystem }}"
{{- if has .Connectors "postgres" }}


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
    """Hold the database pool for as long as the app runs."""
    with db.open_pool() as pool:
        app.state.pool = pool
        yield


app = FastAPI(title={{ printf "%q" .DisplayName }}, lifespan=lifespan)
{{- else }}

app = FastAPI(title={{ printf "%q" .DisplayName }})
{{- end }}
logs.configure()
app.middleware("http")(logs.log_request)


@app.get("/")
def root() -> dict[str, str]:
    """Name this container and its software system."""
    return {"container": CONTAINER, "softwareSystem": SOFTWARE_SYSTEM}


@app.get("/healthz")
def healthz() -> dict[str, str]:
    """Report that the process is up."""
    return {"status": "ok"}
{{- if has .Connectors "postgres" }}


@app.get("/readyz")
def readyz(
    response: Response, pool: Annotated[ConnectionPool, Depends(db.get_pool)]
) -> dict[str, str]:
    """Ready while the database answers SELECT 1; 503 when it doesn't."""
    if db.ping(pool):
        return {"database": "ok"}
    response.status_code = 503
    return {"database": "unreachable"}
{{- end }}
