{{- /*
  For a Container whose release builds an image (an operator, or an
  aws-fargate-ts service), the image job builds it on the image runner and
  attaches it to the release, and the operator pushes it to the Git host's
  registry. An operator's release job runs after it, so make dist names the
  image by digest there; a Fargate stack takes it as a deploy parameter
  instead. Any other Container releases files only. {{`${{ … }}`}} writes a
  Gitea expression as is.
*/ -}}
{{- $image := buildsImage .Deployment .Framework .Type -}}
{{- $operator := eq .Type "operator" -}}
{{- /* registries: the step that routes the factory's npm and PyPI packages to
  the owner's registries. */ -}}
{{- define "registries" }}
      - name: Credentials for the package registries
        # The factory's packages (other apps of this project) come from the
        # owner's npm registry and PyPI index, the Git host's own unless the
        # GitProvider's spec.packages names others: then the operator sets
        # these Actions variables and secrets, and empty ones mean the host.
        # npm sends the scope to the registry through ~/.npmrc; uv logs in to
        # the index with ~/.netrc, whose machine is the hostname alone: uv, pip
        # and requests match it without the port, which npm keeps. A token of
        # the index is the password of the user __token__. A package the
        # registry lacks fails here instead of being asked of npmjs.org or
        # pypi.org.
        env:
          NPM_SCOPE: {{`${{ vars.THEOS_NPM_SCOPE }}`}}
          NPM_REGISTRY: {{`${{ vars.THEOS_NPM_REGISTRY }}`}}
          NPM_TOKEN: {{`${{ secrets.THEOS_NPM_TOKEN }}`}}
          PYPI_INDEX: {{`${{ vars.THEOS_PYPI_INDEX }}`}}
          PYPI_TOKEN: {{`${{ secrets.THEOS_PYPI_TOKEN }}`}}
          SERVER: {{`${{ gitea.server_url }}`}}
          OWNER: {{`${{ gitea.repository_owner }}`}}
          ACTOR: {{`${{ gitea.actor }}`}}
          TOKEN: {{`${{ gitea.token }}`}}
        run: |
          registry=${NPM_REGISTRY:-$SERVER/api/packages/$OWNER/npm/}
          registry=${registry%/}/
          index=${PYPI_INDEX:-$SERVER/api/packages/$OWNER/pypi/simple}
          host=${index#*://}
          host=${host%%/*}
          host=${host%%:*}
          login=${PYPI_TOKEN:+__token__}
          login=${login:-$ACTOR}
          umask 077
          printf '%s:registry=%s\n//%s:_authToken=%s\n' "${NPM_SCOPE:-@theos}" "$registry" "${registry#*://}" "${NPM_TOKEN:-$TOKEN}" > "$HOME/.npmrc"
          printf 'machine %s\nlogin %s\npassword %s\n' "$host" "$login" "${PYPI_TOKEN:-$TOKEN}" > "$HOME/.netrc"
{{- end -}}
# Builds the release files with `make dist` when a version tag (v1.2.3) is
# pushed, and attaches every file in dist/ but dotfiles to the Gitea release of that tag,
# creating the release when it is missing. Running it again replaces the files.
{{- if $image }}
#
# The release builds its image first: rootless BuildKit, on the
# image runner, builds the Dockerfile at the root for linux/amd64 and
# linux/arm64 with an SBOM and provenance, into an OCI image layout archive,
# <repository>-<tag>.oci.tar, attached to the release; the operator pushes it
# from there to the Git host's container registry. Nothing emulates the other
# platform: the Dockerfile RUNs only in stages FROM --platform=$BUILDPLATFORM.
{{- end }}
{{- if $operator }}
# The release files name that image by digest, where the push puts it. The
# operator pushes a tag once, so a rerun names the digest the registry
# already holds for the tag, not the one it rebuilt.
{{- else if $image }}
# The deployer copies the image, by digest, from there to the cloud.
{{- end }}
name: release

on:
  push:
    tags: ["v*"]

jobs:
{{- if $image }}
  image:
    runs-on: image
    outputs:
      digest: {{`${{ steps.build.outputs.digest }}`}}
    env:
      API: {{`${{ gitea.server_url }}`}}/api/v1/repos/{{`${{ gitea.repository }}`}}
      TOKEN: {{`${{ gitea.token }}`}}
      TAG: {{`${{ gitea.ref_name }}`}}
      REPOSITORY: {{`${{ gitea.repository }}`}}
    steps:
      - name: Check out
        run: |
          git init -q .
          git -c http.extraHeader="Authorization: token $TOKEN" \
            fetch -q --depth 1 "{{`${{ gitea.server_url }}`}}/{{`${{ gitea.repository }}`}}.git" "{{`${{ gitea.sha }}`}}"
          git checkout -q FETCH_HEAD
      # buildctl-daemonless.sh starts buildkitd for this job only, its state in
      # the job's RUNNER_TEMP; the SBOM scanner is pinned by digest. The digest
      # is the index's: the one the release files name.
      - name: Build the image
        id: build
        run: |
          test -f Dockerfile || { echo "No Dockerfile at the root: a release that builds an image needs one." >&2; exit 1; }
          archive="$RUNNER_TEMP/${REPOSITORY##*/}-$TAG.oci.tar"
          buildctl-daemonless.sh build \
            --frontend dockerfile.v0 \
            --local context=. \
            --local dockerfile=. \
            --opt platform=linux/amd64,linux/arm64 \
            --opt attest:sbom=generator=docker/buildkit-syft-scanner:1.9.0@sha256:e930c2697be77cb7271d316ecfa78768b5eac73de3b16018ed38eb0ea0b5a7cb \
            --opt attest:provenance=mode=min \
            --output "type=oci,dest=$archive" \
            --metadata-file "$RUNNER_TEMP/metadata.json"
          digest=$(jq -r '."containerimage.digest"' "$RUNNER_TEMP/metadata.json")
          echo "Built $(basename "$archive"), index $digest"
          echo "archive=$archive" >> "$GITHUB_OUTPUT"
          echo "digest=$digest" >> "$GITHUB_OUTPUT"
      - name: Attach the image to the release
        env:
          ARCHIVE: {{`${{ steps.build.outputs.archive }}`}}
        run: |
          auth="Authorization: token $TOKEN"
          release=$(curl -sf -H "$auth" "$API/releases/tags/$TAG" || true)
          if [ -z "$release" ]; then
            release=$(curl -sS --fail-with-body -X POST -H "$auth" -H "Content-Type: application/json" \
              -d "{\"tag_name\": \"$TAG\", \"name\": \"$TAG\"}" "$API/releases")
            echo "Created release $TAG"
          fi
          id=$(printf '%s' "$release" | jq -r .id)
          name=$(basename "$ARCHIVE")
          old=$(printf '%s' "$release" | jq -r --arg n "$name" '(.assets // [])[] | select(.name == $n) | .id')
          if [ -n "$old" ]; then
            curl -sS --fail-with-body -X DELETE -H "$auth" "$API/releases/$id/assets/$old"
          fi
          curl -sS --fail-with-body -X POST -H "$auth" -F "attachment=@$ARCHIVE" \
            "$API/releases/$id/assets?name=$name" > /dev/null
          echo "Attached $name to release $TAG"
{{- end }}
  release:
    runs-on: go
{{- if $image }}
    needs: image
{{- end }}
    env:
      API: {{`${{ gitea.server_url }}`}}/api/v1/repos/{{`${{ gitea.repository }}`}}
      TOKEN: {{`${{ gitea.token }}`}}
      TAG: {{`${{ gitea.ref_name }}`}}
{{- if $operator }}
      SERVER_URL: {{`${{ gitea.server_url }}`}}
      REPOSITORY: {{`${{ gitea.repository }}`}}
      DIGEST: {{`${{ needs.image.outputs.digest }}`}}
{{- end }}
      # npm's cache goes to the runner's memory-backed /tmp: on its disk it
      # stalls the node. Go's build cache stays where the toolchain image
      # ships it, warm.
      npm_config_cache: /tmp/npm-cache
    steps:
      - name: Check out
        run: |
          git init -q .
          git -c http.extraHeader="Authorization: token $TOKEN" \
            fetch -q --depth 1 "{{`${{ gitea.server_url }}`}}/{{`${{ gitea.repository }}`}}.git" "{{`${{ gitea.sha }}`}}"
          git checkout -q FETCH_HEAD
{{- template "registries" }}
      # uv's cache and the Python it installs, for a Python project, go in the
      # checkout, which is in memory and goes with the job, as in the checks.
      - name: make dist
        run: |
          export UV_CACHE_DIR="$PWD/.uv/cache" UV_PYTHON_INSTALL_DIR="$PWD/.uv/python"
{{- if $operator }}
          # The image as the operator pushes it: <host>/<owner>/<repository>,
          # lowercase, on the Git host's registry, by digest. The registry is
          # at the host's root, whatever path ROOT_URL has, and the digest is
          # checked: without it the release files would name an image that is
          # not there (#1581).
          printf '%s\n' "$DIGEST" | grep -Eq '^sha256:[0-9a-f]{64}$' ||
            { echo "The image job gave no digest (got '$DIGEST'); the release files need one." >&2; exit 1; }
          host=${SERVER_URL#*://}
          repository=$(printf '%s' "$REPOSITORY" | tr A-Z a-z)
          # The operator pushes a tag once and never replaces it, so when the
          # registry already holds this tag (a rerun, or a tag moved after a
          # failed run) the release files name that digest, not the one just
          # built: a rebuild's digest differs and nothing would pull it (#1583).
          # 404 is the first run; anything but 200 or 404 fails the step.
          headers=$(mktemp)
          code=$(curl -sS -I -o /dev/null -D "$headers" -w '%{http_code}' -u "x:$TOKEN" \
            -H 'Accept: application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json' \
            "${SERVER_URL%%://*}://${host%%/*}/v2/$repository/manifests/$TAG")
          case "$code" in
            200)
              held=$(tr -d '\r' < "$headers" | awk 'tolower($1) == "docker-content-digest:" { print $2 }')
              printf '%s\n' "$held" | grep -Eq '^sha256:[0-9a-f]{64}$' ||
                { echo "The registry holds $TAG but gave no digest for it (got '$held')." >&2; exit 1; }
              if [ "$held" != "$DIGEST" ]; then
                echo "The registry holds $TAG as $held; the release files name it, not the $DIGEST just built, which is not pushed."
              fi
              DIGEST=$held ;;
            404) echo "The registry does not hold $TAG yet; the release files name the $DIGEST just built." ;;
            *) echo "Asking the registry for $TAG failed with HTTP $code; the release files need the digest it holds." >&2; exit 1 ;;
          esac
          image="${host%%/*}/$repository@$DIGEST"
          make dist VERSION="$TAG" IMG="$image"
{{- else }}
          make dist VERSION="$TAG"
{{- end }}
      - name: Attach dist/ to the release
        run: |
          auth="Authorization: token $TOKEN"
          # A dotfile, such as the .gitignore that keeps dist/ out of git, is
          # not a release file.
          files=$(find dist -maxdepth 1 -type f ! -name '.*' | sort)
          test -n "$files" || { echo "make dist wrote no files into dist/" >&2; exit 1; }
          release=$(curl -sf -H "$auth" "$API/releases/tags/$TAG" || true)
          if [ -z "$release" ]; then
            release=$(curl -sS --fail-with-body -X POST -H "$auth" -H "Content-Type: application/json" \
              -d "{\"tag_name\": \"$TAG\", \"name\": \"$TAG\"}" "$API/releases")
            echo "Created release $TAG"
          fi
          id=$(printf '%s' "$release" | jq -r .id)
          for file in $files; do
            name=$(basename "$file")
            old=$(printf '%s' "$release" | jq -r --arg n "$name" '(.assets // [])[] | select(.name == $n) | .id')
            if [ -n "$old" ]; then
              curl -sS --fail-with-body -X DELETE -H "$auth" "$API/releases/$id/assets/$old"
            fi
            curl -sS --fail-with-body -X POST -H "$auth" -F "attachment=@$file" \
              "$API/releases/$id/assets?name=$name" > /dev/null
            echo "Attached $name to release $TAG"
          done
