{
  "name": "{{ .NpmScope }}/{{ .Container }}",
  "description": "The {{ .Container }} command-line program of {{ .SoftwareSystem }}.",
  "version": "0.0.1",
  "private": true,
  "license": "{{ or .License.ID "UNLICENSED" }}",
  "type": "module",
  "bin": {
    "{{ .Container }}": "out/cli.js"
  },
  "files": [
    "out/cli.js",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "prepack": "node esbuild.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
