{{- if eq .Type "job" -}}
"""The job: one run of its work, then exit 0 when done or 1 when it failed."""

import logging
from collections.abc import Callable

logger = logging.getLogger(__name__)


def run(work: Callable[[], None]) -> int:
    """Do `work` once and return the exit code.

    A run that raises is logged with its traceback and exits 1, so whatever
    runs the job (a Kubernetes Job, up to its `backoffLimit`) may retry it.

    Args:
        work: The job's work, done once.

    Returns:
        The exit code: 0 when `work` returned, 1 when it raised.
    """
    try:
        work()
    except Exception:
        logger.exception("failed")
        return 1
    logger.info("done")
    return 0


def work() -> None:
    """The job's work: take what is due, handle it, record it, and return."""
    logger.info("nothing to do")


def main() -> int:
    """Run the job once, the `[project.scripts]` entry point.

    Logs go to stderr, one line per event.

    Returns:
        The exit code: 0 when the job is done, 1 when it failed.
    """
    logging.basicConfig(
        level=logging.INFO, format="%(asctime)s %(levelname)s %(name)s: %(message)s"
    )
    logger.info("started")
    return run(work)
{{ end -}}
