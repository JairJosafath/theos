{{- if eq .Type "worker" -}}
import pytest

from app.backoff import INTERVAL_SECONDS, MAX_SECONDS, next_delay


@pytest.mark.parametrize(
    ("failures", "expected"),
    [
        (0, INTERVAL_SECONDS),
        (1, 2 * INTERVAL_SECONDS),
        (2, 4 * INTERVAL_SECONDS),
        (100, MAX_SECONDS),
        (10_000, MAX_SECONDS),
    ],
    ids=["success", "one", "two", "capped", "huge"],
)
def test_next_delay(failures: int, expected: float) -> None:
    assert next_delay(failures) == expected


def test_negative_failures_are_an_error() -> None:
    with pytest.raises(ValueError, match="failures must be 0 or more, got -1"):
        next_delay(-1)
{{ end -}}
