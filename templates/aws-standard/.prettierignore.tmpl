# Prettier also skips what .gitignore lists (node_modules/, cdk.out/).

# Written by the platform, which agents can't change.
.theos.yaml
.devcontainer/
{{ .CI.Dir }}

# Written by the factory: the Standard's guides and the agents' Claude Code
# configuration, which agents never edit (github.com/JairJosafath/theos/issues/38,
# github.com/JairJosafath/theos/issues/259).
docs/agents/
.claude/

# Written by npm.
package-lock.json

# Written by cdk synth and make dist, should .gitignore ever lose them.
cdk.out/
dist/
{{- if eq .Framework "aws-lambda-go" }}

# go-standard's, copied byte for byte so the two can't drift.
.golangci.yml
{{- end }}
