// Lint config for the {{ if eq .Framework "aws-ec2-ts" }}server's{{ else if eq .Framework "aws-fargate-ts" }}service's{{ else if eq .Framework "aws-lambda-py" }}Python function's CDK app, in{{ else }}function's{{ end }} TypeScript{{ if ne .Framework "aws-lambda-py" }} and its CDK app{{ end }}: typescript-eslint's strictest
// type-checked presets, plus the rules below. `make lint` runs ESLint with
// --max-warnings 0, so any finding fails `make check`. Every rule turned off
// or changed here says why. Changing this file is the Standard's job, not a
// task's.
import js from '@eslint/js';
import { defineConfig, globalIgnores } from 'eslint/config';
import tseslint from 'typescript-eslint';

export default defineConfig(
{{- if eq .Framework "aws-fargate-ts" }}
  // What cdk synth writes (templates, the image's staged context) and what
  // npm run bundle writes.
  globalIgnores(['cdk.out/', 'dist/']),
{{- else }}
  // What cdk synth writes: templates and the bundled {{ if eq .Framework "aws-ec2-ts" }}server{{ else }}function{{ end }}{{ if eq .Framework "aws-lambda-py" }};
  // and uv's environment, whose packages ship JavaScript of their own{{ end }}.
  globalIgnores(['cdk.out/'{{ if eq .Framework "aws-lambda-py" }}, '.venv/'{{ end }}]),
{{- end }}
  js.configs.recommended,
  tseslint.configs.strictTypeChecked,
  tseslint.configs.stylisticTypeChecked,
  {
    languageOptions: {
      parserOptions: {
        // Type information from tsconfig.json, for every file it includes.
        projectService: true,
        tsconfigRootDir: import.meta.dirname,
      },
    },
    linterOptions: {
      // A disable comment that silences nothing is dead code.
      reportUnusedDisableDirectives: 'error',
    },
    rules: {
      // A switch over a union or enum names every member, so a new member
      // fails the lint wherever it must be handled. A default branch does
      // not count.
      '@typescript-eslint/switch-exhaustiveness-check': [
        'error',
        { considerDefaultExhaustiveForUnions: false, requireDefaultForNonUnion: true },
      ],
      // Exported functions state their parameter and return types: they are
      // the module's contract.
      '@typescript-eslint/explicit-module-boundary-types': 'error',
      // Members never reassigned after construction are readonly.
      '@typescript-eslint/prefer-readonly': 'error',
      // Array#sort without a compare function sorts numbers as strings.
      '@typescript-eslint/require-array-sort-compare': ['error', { ignoreStringArrays: true }],
      // The code logs structured JSON through the Log it is given, so
      // tests see what it logs and every entry is one parseable line.
      'no-console': 'error',
{{ if eq .Framework "aws-ec2-ts" }}      // process.exit() ends the server mid-request; throw, return an error
      // response, or on SIGTERM close the server and let the process end.{{ else if eq .Framework "aws-fargate-ts" }}      // process.exit() drops the requests in flight; on SIGTERM the server
      // closes and the process ends when they are done.{{ else if eq .Framework "aws-queue-ts" }}      // process.exit() in a Lambda function kills the execution environment
      // mid-batch; throw, and the batch reports the message failed.{{ else }}      // process.exit() in a Lambda function kills the execution environment
      // mid-invocation; throw, or return an error response.{{ end }}
      'no-restricted-properties': [
        'error',
        {
          object: 'process',
          property: 'exit',
          message: {{ if eq .Framework "aws-ec2-ts" }}'Throw, or return an error response; never end the server mid-request.'{{ else if eq .Framework "aws-fargate-ts" }}'Close the server and let the process end; never drop the requests in flight.'{{ else if eq .Framework "aws-queue-ts" }}'Throw: the batch reports the failed message; never end the environment.'{{ else }}'Throw, or return an error response; never end the execution environment.'{{ end }},
        },
      ],
      eqeqeq: ['error', 'always'],
      curly: ['error', 'all'],
    },
  },
  {
    // Build and config scripts are plain JavaScript, outside tsconfig.json.
    files: ['**/*.mjs'],
    extends: [tseslint.configs.disableTypeChecked],
  },
);
