{{ if eq .Framework "aws-lambda-py" -}}
// Lint config for the CDK app's TypeScript: typescript-eslint's strictest
{{ else -}}
// Lint config for the function's TypeScript and its CDK app: typescript-eslint's strictest
{{ end -}}
// type-checked presets, plus the rules below. `make lint` runs ESLint with
// --max-warnings 0, so any finding fails `make check`. Every rule turned off
// or changed here says why. Changing this file is the Standard's job, not a
// task's.
import js from '@eslint/js';
import { defineConfig, globalIgnores } from 'eslint/config';
import tseslint from 'typescript-eslint';

export default defineConfig(
{{- if eq .Framework "aws-lambda-py" }}
  // What cdk synth writes, and uv's environment, whose packages ship
  // JavaScript of their own.
  globalIgnores(['cdk.out/', '.venv/']),
{{- else }}
  // What cdk synth writes: templates and the bundled function.
  globalIgnores(['cdk.out/']),
{{- end }}
  js.configs.recommended,
  tseslint.configs.strictTypeChecked,
  tseslint.configs.stylisticTypeChecked,
  {
    languageOptions: {
      parserOptions: {
        // Type information from tsconfig.json, for every file it includes.
        projectService: true,
        tsconfigRootDir: import.meta.dirname,
      },
    },
    linterOptions: {
      // A disable comment that silences nothing is dead code.
      reportUnusedDisableDirectives: 'error',
    },
    rules: {
      // A switch over a union or enum names every member, so a new member
      // fails the lint wherever it must be handled. A default branch does
      // not count.
      '@typescript-eslint/switch-exhaustiveness-check': [
        'error',
        { considerDefaultExhaustiveForUnions: false, requireDefaultForNonUnion: true },
      ],
      // Exported functions state their parameter and return types: they are
      // the module's contract.
      '@typescript-eslint/explicit-module-boundary-types': 'error',
      // Members never reassigned after construction are readonly.
      '@typescript-eslint/prefer-readonly': 'error',
      // Array#sort without a compare function sorts numbers as strings.
      '@typescript-eslint/require-array-sort-compare': ['error', { ignoreStringArrays: true }],
      // The function logs structured JSON through the Log it is given, so
      // tests see what it logs and every entry is one parseable line.
      'no-console': 'error',
      // process.exit() in a Lambda function kills the execution environment
      // mid-invocation; throw, or return an error response.
      'no-restricted-properties': [
        'error',
        {
          object: 'process',
          property: 'exit',
          message: 'Throw, or return an error response; never end the execution environment.',
        },
      ],
      eqeqeq: ['error', 'always'],
      curly: ['error', 'all'],
    },
  },
  {
    // Build and config scripts are plain JavaScript, outside tsconfig.json.
    files: ['**/*.mjs'],
    extends: [tseslint.configs.disableTypeChecked],
  },
);
