# Build context for hack/agent/Dockerfile: the Go module, like the operator.
**
!**/*.go
**/*_test.go
# The files theos-agent embeds with //go:embed; cmd/dockerignore_test.go fails
# when one is missing here.
!features/src/**
!internal/model/planner.md
!go.mod
!go.sum

# Local agent worktrees (Claude Code) are not part of any image.
.claude/
