# theos project shell. Loaded through ZDOTDIR=.dev/zsh (VS Code terminals,
# ./dev shell), so it never reads or changes your own ~/.zshrc, and everything it
# writes (history, completion cache, plugins) stays in .dev/.

source "$THEOS_ROOT/hack/dev/env.sh"

# --- oh-my-zsh, from .dev/zsh --------------------------------------------------
export ZSH="$THEOS_DEV/zsh/oh-my-zsh"
export ZSH_CUSTOM="$THEOS_DEV/zsh/custom"
ZSH_THEME="robbyrussell"
# ./dev setup --upgrade fetches a fresh copy; no update prompts in between.
zstyle ':omz:update' mode disabled
# zsh-syntax-highlighting must stay last in this list.
plugins=(git golang docker kubectl helm gh fzf zsh-autosuggestions zsh-syntax-highlighting)
source "$ZSH/oh-my-zsh.sh"

# --- History, kept in .dev/ so the suggestions keep learning --------------------
HISTFILE="$THEOS_DEV/zsh/history"
HISTSIZE=100000
SAVEHIST=100000
setopt INC_APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS

# Grey suggestions while you type: from history first, then from completions.
# Accept all with Right arrow or End, one word with Ctrl+Right.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6b7280'
bindkey '^[[1;5C' forward-word

# Completions oh-my-zsh doesn't ship.
command -v kind >/dev/null && source <(kind completion zsh)
command -v kubebuilder >/dev/null && source <(kubebuilder completion zsh)
command -v uv >/dev/null && eval "$(uv generate-shell-completion zsh)"

# Show it when this device runs without a cluster.
[[ "${THEOS_CLUSTER:-}" == none ]] && print -P '%F{yellow}THEOS_CLUSTER=none: no Kind cluster on this device%f'
