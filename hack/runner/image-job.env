# The image runner's job environment (hack/runner/Dockerfile.image), read by
# the runner for every job (env_file in hack/runner/config.yaml).
# buildctl-daemonless.sh starts $BUILDKITD with $BUILDKITD_FLAGS under
# rootlesskit: c4-buildkitd keeps BuildKit's state in the job's RUNNER_TEMP.
# No process sandbox: RUN steps get no PID namespace of their own, whose /proc
# rootless BuildKit can't mount in a pod without procMount: Unmasked.
BUILDKITD=c4-buildkitd
BUILDKITD_FLAGS=--oci-worker-no-process-sandbox
