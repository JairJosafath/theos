# The relay watch as a systemd user unit. hack/relay-watch.sh --install fills in
# the checkout, the worker count, the installer's PATH, the installer's Claude
# Code login (CLAUDE_CONFIG_DIR, after dev run, which would point it at
# .dev/claude, #1435) and relay settings, and writes it to ~/.config/systemd/user.
#
# Restart=always brings the watch back after a crash, an OOM kill or a kill;
# RestartPreventExitStatus=0 keeps it down when it exits for .relay/stop.
# KillMode=process stops only the watch: the relay workers it started finish
# their sessions.
[Unit]
Description=C4 Factory relay watch (@REPO@)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment="PATH=@PATH@"
@ENV@
ExecStart="@REPO@/dev" run env "CLAUDE_CONFIG_DIR=@CLAUDE_CONFIG_DIR@" "@REPO@/hack/relay-watch.sh" --foreground --workers @WORKERS@
Restart=always
RestartSec=15
RestartPreventExitStatus=0
KillMode=process

[Install]
WantedBy=default.target
