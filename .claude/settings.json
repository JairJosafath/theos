{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/heavy-guard.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/close-guard.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/lib/github.sh beat",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/context-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/pull.sh || true",
            "timeout": 90
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(hack/lib/github.sh land:*)",
      "Bash(hack/release.sh:*)",
      "Bash(hack/lib/github.sh:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh api repos/JairJosafath/theos/milestones:*)",
      "Edit(hack/lib/github.sh)",
      "Bash(claude -p --model fable:*)",
      "Bash(hack/lib/github.sh:*)",
      "Edit(hack/**)",
      "Write(hack/**)",
      "Edit(AGENTS.md)",
      "Edit(docs/**)",
      "Edit(.claude/skills/**)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh label create:*)",
      "Bash(gh issue edit:*)",
      "Bash(make test-hack:*)",
      "Bash(bash hack/lib/github_test.sh:*)"
    ]
  }
}