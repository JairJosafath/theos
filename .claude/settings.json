{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/heavy-guard.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/close-guard.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/lib/github.sh beat",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/context-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hack/pull.sh || true",
            "timeout": 90
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(hack/lib/github.sh land:*)",
      "Bash(hack/release.sh:*)",
      "Bash(hack/lib/github.sh:*)",
      "Bash(hack/relay-watch.sh:*)",
      "Bash(hack/relay.sh:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh api repos/JairJosafath/c4factory/milestones:*)",
       "Edit(hack/relay.sh)",
      "Edit(hack/lib/github.sh)",
      "Bash(claude -p --model fable:*)"
    ]
  }
}